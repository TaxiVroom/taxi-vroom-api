generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// UUID are generated application-side (domain layer: UserEntity.create())
enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum PassengerRegistrationStep {
  SOCIAL_LINK
  EMAIL
  NAME
  NOTIFICATIONS
  COMPLETE
}

enum DriverRegistrationStep {
  SOCIAL_LINK
  EMAIL
  NAME
  DOCUMENTS
  PENDING_REVIEW
  DOCUMENTS_CORRECTION
  COMPLETE
}

model User {
  id        String     @id // The ID is created by Firebase
  firstName String
  lastName  String
  phone     String     @unique
  email     String     @unique
  role      UserRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallet    Wallet?
  passenger Passenger?
  driver    Driver?
  admin     Admin?

  @@map("users")
}

model Passenger {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rides  Ride[]

  @@map("passengers")
}

model Admin {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentValidationEvents RegistrationDocumentValidationEvent[]
  documentRejectionEvents  RegistrationDocumentRejectionEvent[]
  driverSuspensionEvents   DriverSuspensionEvent[]

  @@map("admins")
}

model Driver {
  userId      String  @id
  isSuspended Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents        Document[]
  suspensionEvents DriverSuspensionEvent[]
  rideOffers       RideOffer[]

  @@map("drivers")
}

model DocumentType {
  id           String  @id
  name         String  @unique
  backRequired Boolean @default(false)

  registrationDocuments RegistrationDocument[]
  documents             Document[]

  @@map("document_types")
}

enum DocumentStatus {
  SUBMITTED
  VALIDATED
  REJECTED
}

model RegistrationDocument {
  id             String         @id
  driverRegId    String
  documentTypeId String
  frontFilePath  String
  backFilePath   String?
  status         DocumentStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  driverRegistration DriverRegistration                    @relation(fields: [driverRegId], references: [userId], onDelete: Cascade)
  documentType       DocumentType                          @relation(fields: [documentTypeId], references: [id])
  validationEvents   RegistrationDocumentValidationEvent[]
  rejectionEvents    RegistrationDocumentRejectionEvent[]

  @@unique([driverRegId, documentTypeId])
  @@map("registration_documents")
}

model RegistrationDocumentValidationEvent {
  id          String   @id
  documentId  String
  adminId     String
  validatedAt DateTime @default(now())

  document RegistrationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  admin    Admin                @relation(fields: [adminId], references: [userId])

  @@map("registration_document_validation_events")
}

model RegistrationDocumentRejectionEvent {
  id         String   @id
  documentId String
  adminId    String
  reason     String
  rejectedAt DateTime @default(now())

  document RegistrationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  admin    Admin                @relation(fields: [adminId], references: [userId])

  @@map("registration_document_rejection_events")
}

model Document {
  id             String    @id
  driverId       String
  documentTypeId String
  frontFilePath  String
  backFilePath   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  driver       Driver       @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@map("documents")
}

model DriverSuspensionEvent {
  id          String   @id
  driverId    String
  adminId     String
  reason      String
  suspendedAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [userId])
  admin  Admin  @relation(fields: [adminId], references: [userId])

  @@map("driver_suspension_events")
}

/// Common base for all registration flows.
/// Identified by the Firebase UID - no FK to User because the User row
/// does not exist yet (created only on registration completion).
model Registration {
  id        String   @id
  userId    String   @unique // Firebase UID
  role      UserRole
  phone     String?
  email     String?
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passenger PassengerRegistration?
  driver    DriverRegistration?
}

model PassengerRegistration {
  userId      String                    @id
  currentStep PassengerRegistrationStep @default(SOCIAL_LINK)
  flow        Registration              @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model DriverRegistration {
  userId      String                 @id
  currentStep DriverRegistrationStep @default(SOCIAL_LINK)
  flow        Registration           @relation(fields: [userId], references: [userId], onDelete: Cascade)

  registrationDocuments RegistrationDocument[]
}

model Wallet {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balance   Int      @default(0)
  userId    String   @unique
  /// Cascade: without Cascade, deleting a user fails (FK constraint).
  /// Domain events are published after the DB delete, so they can't
  /// clean up the wallet before the user is removed.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// Where a ride is in its life, from the request to its end.
enum RideStatus {
  SEARCHING_DRIVER
  NO_DRIVER_FOUND
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PASSENGER_NO_SHOW
}

/// A ride requested by a passenger. `status` tells which sub-table holds the
/// details of its current step: the database does not check that they
/// match, RideEntity does.
model Ride {
  id                     String     @id
  passengerId            String
  status                 RideStatus
  /// Null until the pickup address is looked up: the passenger's position.
  originName             String?
  originLatitude         Float
  originLongitude        Float
  destinationName        String
  destinationLatitude    Float
  destinationLongitude   Float
  /// The estimate shown to the passenger when ordering: a taxi runs on its
  /// meter, the real price is only known on arrival.
  estimatedPriceMinCents Int
  estimatedPriceMaxCents Int
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  passenger     Passenger          @relation(fields: [passengerId], references: [userId], onDelete: Cascade)
  offers        RideOffer[]
  noDriverFound RideNoDriverFound?
  boardingCode  RideBoardingCode?

  @@map("rides")
}

/// The code the passenger tells the driver at pickup, so the driver can start
/// the ride. Only its hash is stored (OWASP: never keep one-time codes in
/// plaintext); the passenger reads the code itself from the realtime
/// database. Removed once checked.
model RideBoardingCode {
  rideId   String @id
  codeHash String

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@map("ride_boarding_codes")
}

/// No driver accepted the ride.
model RideNoDriverFound {
  rideId    String   @id
  stoppedAt DateTime

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@map("ride_no_driver_found")
}

enum RideOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/// The ride proposed to one driver, who has 15 seconds to answer. `status`
/// tells which answer table holds the details: the database does not check
/// that they match, RideEntity does.
/// migration.sql adds what Prisma cannot write: one PENDING offer at most
/// per ride, and per driver (partial unique indexes).
model RideOffer {
  id        String          @id
  rideId    String
  driverId  String
  status    RideOfferStatus
  offeredAt DateTime

  ride       Ride                 @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver     Driver               @relation(fields: [driverId], references: [userId], onDelete: Cascade)
  acceptance RideOfferAcceptance?
  decline    RideOfferDecline?
  expiration RideOfferExpiration?

  @@map("ride_offers")
}

/// The driver accepted: the ride is theirs.
model RideOfferAcceptance {
  offerId    String   @id
  acceptedAt DateTime

  offer RideOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("ride_offer_acceptances")
}

/// The driver declined.
model RideOfferDecline {
  offerId    String   @id
  declinedAt DateTime

  offer RideOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("ride_offer_declines")
}

/// The driver did not answer in time.
model RideOfferExpiration {
  offerId   String   @id
  expiredAt DateTime

  offer RideOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("ride_offer_expirations")
}
