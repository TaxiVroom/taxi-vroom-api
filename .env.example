DB_HOST='localhost'
DB_PORT=5432
DB_USERNAME='user'
DB_PASSWORD='password'
DB_NAME='ddh'

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
# Realtime Database: Firebase console > Realtime Database > Data, URL at the top.
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.europe-west1.firebasedatabase.app"

# Mapbox: a token for the server only, not the app's one.
# https://console.mapbox.com/account/access-tokens/
MAPBOX_ACCESS_TOKEN="pk.your-server-token"

# JWT
# To generate a secret : openssl rand -base64 64
JWT_SECRET="your-super-long-random-secret-here"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="30d"
